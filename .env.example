# BioRigCoreV5 deployment configuration. Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Load it into your shell with:  set -a; source .env; set +a
# Placeholders only. No value here is a real secret.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Every chain's RPC, explorer and Blockscout verifier live in dashboard/chains.json; print them with
#   python3 -m dashboard.config chains                       # every registered chain
#   CHAIN_ID=42220 python3 -m dashboard.config get rpc_url    # one field of one chain
# CHAIN_ID picks the chain. Unset, the dashboard and the shell scripts use default_chain_id from
# dashboard/deployment.json. It must equal the eth_chainId the RPC reports; every script asserts this before
# doing anything. It is also passed to initialize() as _chainId, the chain id every token-bound account is
# bound to.
#
# The network values below are Celo Sepolia's (11142220 = 0xaa044c), where the live deployment is, exactly as
#   python3 -m dashboard.config env --chain-id 11142220
# prints them. For Celo mainnet (42220, not deployed yet; runbook in DEPLOY.md section 8) generate the block with
# --chain-id 42220 instead of typing it. Switch CHAIN_ID, RPC_URL, VERIFIER_URL and EXPLORER_URL together:
# RPC_URL and EXPLORER_URL override the chain's entry in dashboard/chains.json. A CHAIN_ID exported in the shell
# (or set in the host's Secrets) over this file drops this file's RPC_URL and EXPLORER_URL rather than mixing two
# chains, and the scripts refuse an RPC whose eth_chainId differs from CHAIN_ID.
# Celo Alfajores (44787) is shut down and replaced by Celo Sepolia; nothing here targets it.
CHAIN_ID=11142220
RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# ---------------------------------------------------------------------------
# Explorer / verification (Blockscout, no API key needed)
# ---------------------------------------------------------------------------
VERIFIER=blockscout
VERIFIER_URL=https://celo-sepolia.blockscout.com/api/
# Base URL for explorer links. The dashboard honours it as an override; the deploy scripts always use a listed
# chain's explorer from dashboard/chains.json and fall back to this only for a chain that file does not list.
EXPLORER_URL=https://celo-sepolia.blockscout.com

# ---------------------------------------------------------------------------
# Deployer
# ---------------------------------------------------------------------------
# Private key (0x-prefixed hex) of the funded account that sends the deployment transactions.
# Celo Sepolia: fund it from https://faucet.celo.org/celo-sepolia or the Google Cloud Web3 faucet.
# Celo mainnet: a fresh key used for this deployment only, funded with ~5 CELO, holding no role once
# script/HardenMainnetAdmin.s.sol has run, and swept afterwards (DEPLOY.md section 8).
# Never commit a real key, and never reuse the public anvil keys from script/fork-dry-run.sh here.
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# ---------------------------------------------------------------------------
# initialize() parameters
# ---------------------------------------------------------------------------
# _defaultAdmin: gets DEFAULT_ADMIN_ROLE and UPGRADER_ROLE, and (in the deploy scripts) VERIFIER_ROLE, since
# initialize does not grant it and mintTree is gated on it.
# Must be non-zero (initialize reverts ZeroAdminAddress).
# MUST equal the address of PRIVATE_KEY: only DEFAULT_ADMIN_ROLE can grant VERIFIER_ROLE, so the scripts refuse to
# broadcast when ADMIN is a different account. The multisig takes over afterwards: see NEW_ADMIN below.
ADMIN=0x0000000000000000000000000000000000000000

# _registry: ERC-6551 registry. Must be non-zero and MUST HAVE CODE, or DeployBioRig refuses to run.
# The canonical registry below has code on both Celo networks: on Celo mainnet from the start, on Celo Sepolia since
# DeployAll put it there on 30 September 2026. dashboard/chains.json records it per chain, with its codehash.
# script/DeployAll.s.sol reads neither this variable nor ERC6551_IMPLEMENTATION.
ERC6551_REGISTRY=0x000000006551c19487814612e58FE06813775758

# _implementation: the ERC-6551 account implementation every tree's token-bound account delegates to.
# Must be non-zero and MUST HAVE CODE. It must report ERC-165 support for 0x6faff5f1 and implement token(),
# or mintTree reverts InvalidTba. Either use an audited one already on the chain, or deploy the vendored EIP example
# with script/DeployERC6551Account.s.sol or script/DeployAll.s.sol (which is what the Celo Sepolia deployment did).
ERC6551_IMPLEMENTATION=0x0000000000000000000000000000000000000000

# _bufferPool: must be non-zero (initialize reverts InvalidAddress). No code required.
BUFFER_POOL=0x0000000000000000000000000000000000000000

# _uriGenerator: ITokenURIGenerator contract, or 0x0000000000000000000000000000000000000000 for none.
# Required in the env so the choice is explicit. Zero is legal. If non-zero, it must have code.
URI_GENERATOR=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Role handover: script/HardenMainnetAdmin.s.sol, run after the broadcast (DEPLOY.md section 8)
# ---------------------------------------------------------------------------
# It also reads PRIVATE_KEY (the deployer, which still holds every role), CHAIN_ID and PROXY_ADDRESS (below).
# NEW_ADMIN: the Safe that gets DEFAULT_ADMIN_ROLE and UPGRADER_ROLE. Must be a deployed Safe, and the deployer
# must not be one of its owners.
NEW_ADMIN=0x0000000000000000000000000000000000000000
# VERIFIER_ADDRESS: the dedicated server-side key that gets VERIFIER_ROLE. Neither the deployer nor NEW_ADMIN.
# Only its address belongs here; the key itself stays on the server that signs mints.
VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Optional: script/DeployERC6551Registry.s.sol only
# ---------------------------------------------------------------------------
# canonical (default): deploy via Nick's factory to 0x000000006551c19487814612e58FE06813775758
# source: deploy src/vendor/ERC6551Registry.sol at a fresh address (only where Nick's factory is absent)
ERC6551_REGISTRY_MODE=canonical

# ---------------------------------------------------------------------------
# Demo dashboard (dashboard/app.py, root streamlit_app.py)
# ---------------------------------------------------------------------------
# The dashboard resolves the proxy address from the first of these that yields one:
#   1. broadcast/DeployAll.s.sol/<CHAIN_ID>/run-latest.json
#   2. broadcast/DeployBioRig.s.sol/<CHAIN_ID>/run-latest.json
#   3. PROXY_ADDRESS below (or, hosted, the same key in the platform's Secrets)
#   4. dashboard/deployment.json, the committed per-chain record of real deployments
# Leave this empty to rely on 1, 2 and 4; the dashboard fails loudly only if all four come up empty.
# script/HardenMainnetAdmin.s.sol requires it: the proxy whose roles it hands over.
PROXY_ADDRESS=
# Optional: block the proxy was created in, so the TreeMinted log scan does not start at block 0.
PROXY_DEPLOY_BLOCK=
# Keeps the form and the eth_call simulation but removes the button that broadcasts a real mintTree from
# the server-side verifier key. Set false on a world-readable URL; unset means true, as on a local run,
# and anything unrecognised counts as false, so a typo cannot re-enable broadcasting.
# Hosted, every key in this section belongs in the platform's Secrets, never in this file.
ALLOW_MINT=true
