# BioRigCoreV5 deployment configuration. Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Load it into your shell with:  set -a; source .env; set +a
# Placeholders only. No value here is a real secret.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Celo Sepolia (default target). Chain id 11142220 = 0xaa044c. Native currency: CELO.
RPC_URL=https://forno.celo-sepolia.celo-testnet.org
# Must equal the eth_chainId the RPC reports; every script asserts this before doing anything.
# It is also passed to initialize() as _chainId, the chain id every token-bound account is bound to.
CHAIN_ID=11142220
# Other chains, for reference only:
#   Celo mainnet:      CHAIN_ID=42220     RPC_URL=https://forno.celo.org
#   Celo Alfajores:    CHAIN_ID=44787     listed only for completeness. Alfajores is shut down and replaced by
#                                         Celo Sepolia. Its RPC no longer resolves, so do not use it.

# ---------------------------------------------------------------------------
# Explorer / verification (Blockscout, no API key needed)
# ---------------------------------------------------------------------------
VERIFIER=blockscout
VERIFIER_URL=https://celo-sepolia.blockscout.com/api/
# Base URL the deploy scripts print address links against. Override for another chain.
EXPLORER_URL=https://celo-sepolia.blockscout.com
# Celo mainnet also has a Blockscout: https://celo.blockscout.com/api/

# ---------------------------------------------------------------------------
# Deployer
# ---------------------------------------------------------------------------
# Private key (0x-prefixed hex) of the funded account that sends the deployment transactions.
# Fund it from https://faucet.celo.org/celo-sepolia or the Google Cloud Web3 faucet.
# Never commit a real key, and never reuse the public anvil key from script/fork-dry-run.sh here.
# Use a dedicated low-value testnet deployer.
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# ---------------------------------------------------------------------------
# initialize() parameters
# ---------------------------------------------------------------------------
# _defaultAdmin: gets DEFAULT_ADMIN_ROLE and UPGRADER_ROLE, and (in the deploy scripts) VERIFIER_ROLE, since
# initialize does not grant it and mintTree is gated on it. Use a multisig for anything beyond testing.
# Must be non-zero (initialize reverts ZeroAdminAddress).
# MUST equal the address of PRIVATE_KEY: only DEFAULT_ADMIN_ROLE can grant VERIFIER_ROLE, so the scripts refuse to
# broadcast when ADMIN is a different account.
ADMIN=0x0000000000000000000000000000000000000000

# _registry: ERC-6551 registry. Must be non-zero and MUST HAVE CODE, or DeployBioRig refuses to run.
# The canonical registry below exists on Celo mainnet but NOT on Celo Sepolia. On Celo Sepolia, deploy it first
# with script/DeployERC6551Registry.s.sol, or let script/DeployAll.s.sol do everything in one command.
# script/DeployAll.s.sol reads neither this variable nor ERC6551_IMPLEMENTATION.
ERC6551_REGISTRY=0x000000006551c19487814612e58FE06813775758

# _implementation: the ERC-6551 account implementation every tree's token-bound account delegates to.
# Must be non-zero and MUST HAVE CODE. It must report ERC-165 support for 0x6faff5f1 and implement token(),
# or mintTree reverts InvalidTba. No account implementation is deployed on Celo Sepolia. Either deploy an audited
# one, or deploy the vendored EIP example with script/DeployERC6551Account.s.sol or script/DeployAll.s.sol.
ERC6551_IMPLEMENTATION=0x0000000000000000000000000000000000000000

# _bufferPool: must be non-zero (initialize reverts InvalidAddress). No code required.
BUFFER_POOL=0x0000000000000000000000000000000000000000

# _uriGenerator: ITokenURIGenerator contract, or 0x0000000000000000000000000000000000000000 for none.
# Required in the env so the choice is explicit. Zero is legal. If non-zero, it must have code.
URI_GENERATOR=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Optional: script/DeployERC6551Registry.s.sol only
# ---------------------------------------------------------------------------
# canonical (default): deploy via Nick's factory to 0x000000006551c19487814612e58FE06813775758
# source: deploy src/vendor/ERC6551Registry.sol at a fresh address (only where Nick's factory is absent)
ERC6551_REGISTRY_MODE=canonical

# ---------------------------------------------------------------------------
# Demo dashboard (dashboard/app.py) only
# ---------------------------------------------------------------------------
# Fallback for the proxy address. The dashboard first reads the ERC1967Proxy entry from
# broadcast/DeployAll.s.sol/<CHAIN_ID>/run-latest.json, then broadcast/DeployBioRig.s.sol/..., and only then this.
# Leave empty to rely on the broadcast artifact; the dashboard fails loudly if none of the three resolves.
PROXY_ADDRESS=
# Optional: block the proxy was created in, so the TreeMinted log scan does not start at block 0.
PROXY_DEPLOY_BLOCK=
