# BioRigCoreV5 — Celo mainnet deployment environment (TEMPLATE).
#
#   cp .env.mainnet.example .env.mainnet && chmod 600 .env.mainnet
#   # fill in the five empty values (PRIVATE_KEY, ADMIN, BUFFER_POOL, NEW_ADMIN, VERIFIER_ADDRESS)
#   # and, for the Safe owner swap (step 7a), SAFE_ADDRESS and NEW_OWNER
#   set -a; source .env.mainnet; set +a
#
# Then follow DEPLOY.md section 8 from step 4 onwards (simulate, broadcast, verify, hand the roles over).
#
# No value in this file is a real secret, and none may become one: .env.mainnet is gitignored by the .env.* rule,
# this template is committed. The deployer key goes in PRIVATE_KEY and nowhere else — never commit it, never paste
# it into a chat, and remove it (with .deploy/) once step 7 has handed the roles over.
#
# The network block below is exactly what `python3 -m dashboard.config env --chain-id 42220` prints from
# dashboard/chains.json, which stays the single source of truth: regenerate the block with that command if the
# registry changes. tools/test_env_template.py fails if this block and the registry disagree, or if a variable a
# deploy script requires is missing from this template.

# ---------------------------------------------------------------------------
# Network (Celo mainnet)
# ---------------------------------------------------------------------------
CHAIN_ID=42220
RPC_URL=https://forno.celo.org
VERIFIER=blockscout
VERIFIER_URL=https://celo.blockscout.com/api/
EXPLORER_URL=https://celo.blockscout.com

# ---------------------------------------------------------------------------
# Deployer (DEPLOY.md section 8, steps 1-3)
# ---------------------------------------------------------------------------
# 32-byte hex, in either documented form: 0x plus 64 hex digits, or the 64 digits bare. Generate a key used for this
# deployment and nothing else:
#   cast wallet new --json > .deploy/mainnet-deployer.json && chmod 600 .deploy/mainnet-deployer.json
# and fund it with about 5 CELO. It sends the four deployment transactions and the handover. After step 7 it holds
# no admin and no upgrade; whether it also still holds VERIFIER_ROLE depends on VERIFIER_ADDRESS below, and the
# rest of its balance is swept back in step 7.
PRIVATE_KEY=

# initialize() _defaultAdmin, and (in the deploy scripts) the initial VERIFIER_ROLE holder, since initialize does
# not grant it and mintTree is gated on it. MUST equal the address of PRIVATE_KEY: only DEFAULT_ADMIN_ROLE can
# grant VERIFIER_ROLE, so DeployCommon refuses to broadcast when they differ.
#   cast wallet address --private-key "$PRIVATE_KEY"     # prints the address to put here
ADMIN=

# ---------------------------------------------------------------------------
# initialize() parameters
# ---------------------------------------------------------------------------
# _bufferPool: must be non-zero (initialize reverts InvalidAddress). No code required. The pool address this
# chain's deployment uses.
BUFFER_POOL=

# _uriGenerator: ITokenURIGenerator contract, or 0x0000000000000000000000000000000000000000 for none.
# Required here so the choice is explicit; zero is legal.
URI_GENERATOR=0x0000000000000000000000000000000000000000

# _registry: the canonical ERC-6551 registry. Already deployed on Celo mainnet, pinned by its codehash in
# dashboard/chains.json. DeployAll reads it from that registry rather than from this variable, so this line
# matters only to the entry points that do read it: DeployBioRig, and fork-dry-run.sh.
ERC6551_REGISTRY=0x000000006551c19487814612e58FE06813775758

# _implementation: the ERC-6551 account implementation every tree's token-bound account delegates to.
# DeployAll deploys its own (one of its four transactions) and ignores this variable; DeployBioRig requires it.
# Set it only to deploy against an implementation that is already on mainnet.
ERC6551_IMPLEMENTATION=

# ---------------------------------------------------------------------------
# Safe owner swap: script/SafeOwnerSwap.s.sol (DEPLOY.md section 8, step 7a, before the handover)
# ---------------------------------------------------------------------------
# SAFE_ADDRESS: the 1-of-1 Safe whose sole owner is still the deployer key; on 1 October 2026 that is
# 0x3B36b3446fCB0729B0046520156933E56352D551, the Safe that becomes NEW_ADMIN in step 7b.
SAFE_ADDRESS=

# NEW_OWNER: the address that takes that Safe over, one the deployer key cannot sign for (an EOA, or a Safe the
# deployer does not appear in at any depth). The swap refuses the deployer, a current owner, and a deployer-owned Safe.
NEW_OWNER=

# ---------------------------------------------------------------------------
# Role handover: script/HardenMainnetAdmin.s.sol (DEPLOY.md section 8, step 7)
# ---------------------------------------------------------------------------
# NEW_ADMIN: the Safe that ends up holding DEFAULT_ADMIN_ROLE and UPGRADER_ROLE. Must be a deployed Safe whose
# owners do not include the deployer; the handover reads both back and reverts on the first surprise.
NEW_ADMIN=

# VERIFIER_ADDRESS: the dedicated server-side key that keeps VERIFIER_ROLE and signs the mints. Its address only —
# the key itself stays on the signing server. This may also be the deployer address itself, which leaves
# minting on the deploy key: the hot key then keeps mint, update and reportMortality and loses pause, upgrade
# and role administration. That is the choice made on 1 October 2026. Never NEW_ADMIN.
VERIFIER_ADDRESS=

# ---------------------------------------------------------------------------
# Proxy (read back from the broadcast in step 5; required by step 7 and by the dashboard)
# ---------------------------------------------------------------------------
# Left empty, the dashboard resolves the proxy from broadcast/DeployAll.s.sol/42220/run-latest.json and then from
# dashboard/deployment.json. HardenMainnetAdmin.s.sol requires it, so export it right after the broadcast:
#   export PROXY_ADDRESS=$(jq -r '[.transactions[] | select(.transactionType == "CREATE" and .contractName ==
#     "ERC1967Proxy")] | last | .contractAddress' broadcast/DeployAll.s.sol/42220/run-latest.json)
PROXY_ADDRESS=

# Optional: the block the proxy was created in, so the dashboard's TreeMinted log scan does not start at block 0.
PROXY_DEPLOY_BLOCK=

# ---------------------------------------------------------------------------
# Local dashboard only — the deploy scripts read none of this
# ---------------------------------------------------------------------------
# true keeps the mint button and lets it broadcast, for a local run; set false on anything world-readable.
# Unrecognised values count as false, so a typo cannot re-enable broadcasting. Hosted, this belongs in the
# platform's Secrets, never in a sourced file.
ALLOW_MINT=true

# Not set here: ERC6551_REGISTRY_MODE. It is read only by script/DeployERC6551Registry.s.sol, which mainnet does
# not run — the canonical registry already has code there, so DeployAll has no CREATE2 to make.
