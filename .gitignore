cache/
out/

# Deployment secrets (copy .env.example to .env; never commit .env)
.env
.env.*
!.env.example
# The committed Celo mainnet template: .env.mainnet itself stays ignored, only its .example travels
!.env.mainnet.example
# forge script simulation logs (fork-dry-run.sh writes its broadcast logs under cache/)
broadcast/**/dry-run/

# Throwaway deployer key material written by deploy runs
.deploy/
.venv/
__pycache__/
.bolter/
.bolter-task.md

# demo: rendered media and local check artefacts
assets/media/*.mp4
assets/media/*.wav
assets/media/.voiceover/
.shot*.png
.shot.py
.streamlit-run.log
.pytest_cache/

# Hosted Streamlit secrets: paste them into the platform's Secrets UI, never commit them
.streamlit/secrets.toml

# gh CLI state written into the sandbox workspace
.local/
